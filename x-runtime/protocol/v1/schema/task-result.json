{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent.dev/protocol/v1/task-result.schema.json",
  "title": "TaskResult",
  "allOf": [
    { "$ref": "envelope-base.json" },
    {
      "type": "object",
      "required": ["task_id", "ok", "result", "latency_ms"],
      "properties": {
        "type": { "const": "task.result" },
        "task_id": { "type": "string", "minLength": 1 },
        "ok": { "type": "boolean" },
        "result": { "type": "object" },
        "latency_ms": { "type": "integer", "minimum": 0 }
      }
    }
  ]
}
