{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent.dev/protocol/v1/envelope-base.schema.json",
  "title": "EnvelopeBase",
  "type": "object",
  "required": [
    "protocol_version",
    "message_id",
    "timestamp",
    "type"
  ],
  "properties": {
    "protocol_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "message_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0
    },
    "type": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": true
}
