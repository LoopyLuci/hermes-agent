{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hermes-agent.dev/protocol/v1/envelope-error.schema.json",
  "title": "EnvelopeError",
  "type": "object",
  "required": ["type", "error"],
  "properties": {
    "type": { "const": "error" },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    }
  }
}
